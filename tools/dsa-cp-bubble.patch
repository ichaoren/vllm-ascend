def get_c1_sas_cache_stats(self) -> tuple[int, int]:
        """Return cross-step c1 SAS cache hits and misses."""
        return self._c1_sas_cache_hits, self._c1_sas_cache_misses

    # ---------------------------------------------------------------------
    # BEGIN TEMPORARY DIAGNOSTICS -- c1 SAS cache validation. Delete this
    # whole block (and its two call sites, both marked with the same
    # TEMPORARY DIAGNOSTICS banner) once validation is done.
    #
    # Two questions this answers:
    #   1. Why do the residual ~5.5% of lookups miss? Env: always on, logged
    #      every 1000 misses.  VLLM_ASCEND_DSA_SAS_MISS_LOG=0 to silence.
    #   2. Is the signature under-specified? The operator output is reused
    #      across steps even though max_seqlen_kv / seqused_kv / cu_seqlens_ori_kv
    #      all change every step. Env: VLLM_ASCEND_DSA_SAS_AUDIT=1 recomputes
    #      on every hit and byte-compares. Expensive -- validation only.
    # ---------------------------------------------------------------------

    def _diag_record_miss(self, sas_signature: _A5C1SASSignature) -> None:
        """Attribute a miss to a cause so the residual miss rate can be judged.

        ``batch_resize`` (request count changed) is inherent to scheduling.
        ``ramping`` means the request set is stable but some request still has
        ``context_len < 64``, so its ``num_short_rows`` is non-zero and settles
        on its own as the sequence grows. A ``ramping`` share that never decays
        would mean the signature churns for some other reason.
        """
        previous = self._diag_prev_signature
        self._diag_prev_signature = sas_signature
        if previous is None:
            self._diag_miss_cold += 1
        elif len(previous) != len(sas_signature):
            self._diag_miss_batch_resize += 1
        else:
            self._diag_miss_ramping += 1

        total = self._diag_miss_cold + self._diag_miss_batch_resize + self._diag_miss_ramping
        if total % 1000 == 0 and os.getenv("VLLM_ASCEND_DSA_SAS_MISS_LOG", "1") == "1":
            logger.info(
                "[DIAG] c1 SAS miss causes: cold=%d batch_resize=%d ramping=%d "
                "(last_sig_len=%d, sample=%s)",
                self._diag_miss_cold,
                self._diag_miss_batch_resize,
                self._diag_miss_ramping,
                len(sas_signature),
                sas_signature[:4],
            )

    def _diag_audit_cache_hit(
        self,
        cached: torch.Tensor,
        query_start_loc: torch.Tensor,
        seq_lens: torch.Tensor,
        max_seqlen_q: int | torch.Tensor,
        max_seqlen_kv: int | torch.Tensor,
        cu_seqlens_ori_kv: torch.Tensor | None,
        cu_seqlens_cmp_kv: torch.Tensor | None,
    ) -> None:
        """Recompute the metadata from THIS step's inputs and byte-compare.

        Guards the one assumption the signature does not encode: that the
        operator output is invariant to max_seqlen_kv / seqused_kv /
        cu_seqlens_ori_kv within the proven domain. Rebuilding with the current
        (changed) inputs is the whole point -- reusing the kwargs captured when
        the cache was filled would compare the op against itself and pass
        vacuously.
        """
        if os.getenv("VLLM_ASCEND_DSA_SAS_AUDIT", "0") != "1":
            return
        tp_size = get_tensor_model_parallel_world_size()
        metadata_op = DeviceOperator.get_dsa_sparse_attn_metadata_op()
        fresh = metadata_op(
            **DeviceOperator.get_dsa_sparse_attn_metadata_kwargs(self.seqused_q.device),
            num_heads_q=self.model_config.hf_config.num_attention_heads // tp_size,
            num_heads_kv=1,
            head_dim=self.model_config.get_head_size(),
            cu_seqlens_q=query_start_loc,
            cu_seqlens_ori_kv=cu_seqlens_ori_kv,
            cu_seqlens_cmp_kv=cu_seqlens_cmp_kv,
            seqused_q=self.seqused_q,
            seqused_kv=seq_lens,
            max_seqlen_q=max_seqlen_q,
            max_seqlen_kv=max_seqlen_kv,
            batch_size=len(seq_lens),
            cmp_topk=0,
            cmp_ratio=1,
            ori_mask_mode=4,
            cmp_mask_mode=3,
            ori_win_left=self.model_config.hf_config.sliding_window - 1,
            ori_win_right=0,
            layout_q="TND",
            layout_kv="PA_ND",
            has_ori_kv=True,
            has_cmp_kv=False,
        )
        self._diag_audit_checked += 1
        if not torch.equal(fresh, cached):
            self._diag_audit_mismatches += 1
            diff = (fresh != cached).nonzero().flatten()[:8].tolist()
            logger.error(
                "[DIAG] c1 SAS cache MISMATCH #%d of %d checked -- signature is "
                "under-specified. First differing indices=%s fresh=%s cached=%s",
                self._diag_audit_mismatches,
                self._diag_audit_checked,
                diff,
                [int(fresh[i]) for i in diff],
                [int(cached[i]) for i in diff],
            )
        elif self._diag_audit_checked % 1000 == 0:
            logger.info(
                "[DIAG] c1 SAS audit: %d hits byte-verified, %d mismatches",
                self._diag_audit_checked,
                self._diag_audit_mismatches,
            )

    # END TEMPORARY DIAGNOSTICS
