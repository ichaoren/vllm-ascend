+async def dump_raw_request(
+    req_id: str, api: str, raw_request: Any, request: Any
+) -> None:
+    """Dump the body exactly as the client sent it.
+
+    The raw JSON is used rather than ``request.model_dump()`` because a dump has
+    to stay re-postable, and re-serializing through the pydantic model is lossy:
+    ``tool_calls[].function.arguments`` is typed ``str`` (OpenAI sends it
+    JSON-encoded), but model_dump emits the parsed object, so the result fails
+    re-validation with "Input should be a valid string".
+
+    Starlette caches the body once read, and FastAPI has already read it to
+    validate the model, so this does not re-consume the stream.
+
+    Falls back to model_dump when there is no raw request (offline / batch entry
+    points), which is lossy in the way described above but better than nothing.
+    """
+    body: dict[str, Any] | None = None
+    try:
+        if raw_request is not None:
+            body = await raw_request.json()
+    except Exception as e:  # noqa: BLE001 - fall through to model_dump
+        logger.warning(
+            "Could not read raw body for %s (%s); using model_dump", req_id, e
+        )
+    if body is None:
+        try:
+            body = request.model_dump(exclude_unset=True, mode="json")
+        except Exception as e:  # noqa: BLE001 - debugging aid must not break serving
+            logger.warning("Failed to serialize request %s: %s", req_id, e)
+            return
+    dump_request(req_id, api, body)
+
+
